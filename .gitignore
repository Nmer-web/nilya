# local env files
#
# Ignore every .env variant and allow back only the committed template.
# The previous `.env` + `.env*.local` pair missed .env.development,
# .env.production and .env.staging, all of which Expo loads.
.env*
!.env.example

# supabase local state and function secrets
supabase/.branches/
supabase/.temp/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

admin/node_modules/
admin/.next/
admin/.env*.local
.vercel
.env*
