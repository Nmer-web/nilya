# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# EXPO_PUBLIC_* is inlined into the JS bundle at build time, so ONLY values
# that are safe to ship in a public app binary belong here.
#
# The publishable key is one of those: it identifies the project and nothing
# more. Every table is behind RLS, so it grants no access on its own. Find it
# under Project Settings → API Keys.
#
# NEVER put any of these in this file or anywhere else in the app:
#   the service-role / secret key, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET.
# Those belong to the Edge Function runtime (`supabase secrets set`) only.

EXPO_PUBLIC_SUPABASE_URL=https://tggnhpvrvnmrvmsdyxyu.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
