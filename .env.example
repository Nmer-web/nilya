# Copy to .env and fill in. Placeholders only in this file — it is committed.
#
#   cp .env.example .env
#
# EXPO_PUBLIC_* is inlined into the JavaScript bundle at build time, so the
# ONLY values that belong here are ones that are safe to ship inside a public
# app binary. Anyone can extract them from a downloaded app.
#
# Restart the dev server after changing these. They are substituted at build
# time, so a fast refresh will not pick them up.

# Project URL. Settings → Data API.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key ("sb_publishable_…"). Settings → API Keys.
# Safe to ship: it identifies the project and grants nothing on its own,
# because every table is behind row level security.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>


# ─────────────────────────────────────────────────────────────────────────
# Do NOT add server secrets to this file or to .env.
#
#   SUPABASE_SERVICE_ROLE_KEY   (or any sb_secret_… key)
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#
# These belong to the Edge Function runtime and are set out of band:
#
#   supabase secrets set STRIPE_SECRET_KEY=…
#   supabase secrets set STRIPE_WEBHOOK_SECRET=…
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions
# by the platform and never need to be set by hand.
#
# A secret placed in this project's .env is not bundled — Expo only inlines
# EXPO_PUBLIC_* — but it is one rename away from shipping in a public binary,
# so keep them out entirely.
# ─────────────────────────────────────────────────────────────────────────
