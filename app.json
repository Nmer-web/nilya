{
  "expo": {
    "name": "NILYA",
    "slug": "nilya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#0F6E56",
    "scheme": [
      "nilya",
      "sawa"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "backgroundColor": "#FFFFFF",
      "userInterfaceStyle": "light",
      "bundleIdentifier": "com.ahmed94199.nilya",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "backgroundColor": "#0F6E56",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#0F6E56",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "NILYA needs access to your photos so you can add pictures of the products you sell."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7024401-629f-4ff7-9756-9422d3460101"
      }
    }
  }
}
