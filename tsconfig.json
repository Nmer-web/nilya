{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    // Deno, not React Native: npm:/jsr: specifiers and the Deno global are
    // resolved by the Supabase Edge runtime and its own toolchain.
    "supabase",
    // The Next.js admin workspace owns its own tsconfig and path aliases.
    "admin",
    // Node's built-in test runner owns this integration-test surface. The app
    // compiler deliberately includes only Expo/React Native globals.
    "tests"
  ]
}
